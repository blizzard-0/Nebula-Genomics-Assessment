{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Robert Hill",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/ *.ts *.js *.json index.html",
    "format:check": "prettier --check src/ *.ts *.js *.json index.html",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "chart.js": "^4.6.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0"
  }
}
